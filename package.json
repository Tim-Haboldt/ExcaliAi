{
    "name": "Excalidraw AI",
    "version": "0.1.0",
    "private": true,
    "packageManager": "pnpm@10.30.3",
    "engines": {
        "node": "25.8.0",
        "pnpm": "10.30.3"
    },
    "scripts": {
        "dev:next": "next dev",
        "dev:socket": "tsx watch server/socket-server.ts",
        "build": "next build",
        "start": "concurrently --names next,socket \"next start\" \"tsx server/socket-server.ts\"",
        "lint": "eslint",
        "prettier": "prettier --write .",
        "test:e2e": "playwright test"
    },
    "husky": {
        "hooks": {
            "pre-commit": "pnpm prettier"
        }
    },
    "pnpm": {
        "onlyBuiltDependencies": [
            "prisma",
            "@prisma/engines"
        ]
    },
    "dependencies": {
        "@ai-sdk/anthropic": "3.0.58",
        "@ai-sdk/google": "3.0.43",
        "@ai-sdk/openai": "3.0.41",
        "@ai-sdk/react": "3.0.118",
        "@excalidraw/excalidraw": "0.18.0",
        "@prisma/adapter-pg": "7.4.2",
        "@prisma/client": "7.4.2",
        "@tanstack/react-query": "5.90.21",
        "@tanstack/react-query-devtools": "5.91.3",
        "ai": "6.0.116",
        "cookie": "^1.1.1",
        "dotenv": "17.3.1",
        "iron-session": "8.0.4",
        "lucide-react": "0.577.0",
        "next": "16.1.6",
        "react": "19.2.3",
        "react-dom": "19.2.3",
        "react-resizable-panels": "4.7.2",
        "socket.io": "4.8.3",
        "socket.io-client": "4.8.3",
        "zod": "4.3.6"
    },
    "devDependencies": {
        "@playwright/test": "1.58.2",
        "@tailwindcss/postcss": "4.2.1",
        "@types/cookie": "1.0.0",
        "@types/node": "25.3.3",
        "@types/react": "19.2.14",
        "@types/react-dom": "19.2.3",
        "eslint": "10.0.2",
        "eslint-config-next": "16.1.6",
        "husky": "9.1.7",
        "prettier": "3.8.1",
        "prisma": "7.4.2",
        "tailwindcss": "4.2.1",
        "tsx": "4.21.0",
        "typescript": "5.9.3"
    }
}
